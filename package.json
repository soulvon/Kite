{
  "name": "windsurf-pool",
  "displayName": "Kite",
  "description": "Kite 是面向 Windsurf / Devin 的 AI IDE 增强套件：界面增强、多实例分身、AnyBridge 模型路由、多账号号池、自动恢复与长任务自动化。",
  "version": "8.7.29",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/soulvon/Kite"
  },
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "windsurfPool",
          "title": "Kite",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "windsurfPool": [
        {
          "type": "webview",
          "id": "windsurfPool.sidebar",
          "name": " ",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "windsurfPool.openSidebar",
        "title": "打开换号侧栏",
        "category": "Kite",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "windsurfPool.applyPatch",
        "title": "应用 IDE 注入补丁",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.showLog",
        "title": "显示日志面板",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.openLogFile",
        "title": "打开日志文件",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.addAccount",
        "title": "添加账号",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.switchAccount",
        "title": "切换账号（弹窗列表）",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.switchNextAccount",
        "title": "切换下一个账号",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.removeAccount",
        "title": "删除账号",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.showStatus",
        "title": "账号状态",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.checkForUpdates",
        "title": "检查更新",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.restoreWorkbench",
        "title": "恢复原始 Workbench",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.reinjectEnhancement",
        "title": "重新注入 IDE 增强",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.injectBubbleRules",
        "title": "注入智能建议规则",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.removeBubbleRules",
        "title": "移除智能建议规则",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.injectScriptDisciplineRules",
        "title": "注入脚本纪律规则",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.removeScriptDisciplineRules",
        "title": "移除脚本纪律规则",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.fixChecksums",
        "title": "修复 product.json 校验值（消除\"已损坏\"提示）",
        "category": "Kite"
      },
      {
        "command": "windsurfPool.openLogPanel",
        "title": "打开统计面板",
        "category": "Kite",
        "icon": "$(graph)"
      },
      {
        "command": "windsurfPool.openHealthCheck",
        "title": "打开测活面板",
        "category": "Kite",
        "icon": "$(pulse)"
      },
      {
        "command": "windsurfPool.recoverCascadeInput",
        "title": "恢复 Cascade 输入",
        "category": "Kite",
        "icon": "$(debug-restart)"
      },
      {
        "command": "windsurfPool.repairMissingCredentials",
        "title": "修复缺失凭据",
        "category": "Kite",
        "icon": "$(key)"
      }
    ],
    "keybindings": [
      {
        "command": "windsurfPool.switchNextAccount",
        "key": "ctrl+alt+shift+k",
        "mac": "cmd+alt+shift+k",
        "when": "true"
      },
      {
        "command": "windsurfPool.openLogPanel",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "Kite 设置",
      "properties": {
        "windsurfPool.refreshOnSwitch": {
          "type": "boolean",
          "default": false,
          "description": "切换账号后是否自动重载整个窗口。关闭则只注入会话（多数情况可不重载）；若界面未刷新再手动重载或改回开启。"
        },
        "windsurfPool.showSwitchNotification": {
          "type": "boolean",
          "default": false,
          "description": "切换时是否弹出「已切换」提示（侧栏下拉切换默认不弹）"
        },
        "windsurfPool.logoutBeforeSwitch": {
          "type": "boolean",
          "default": false,
          "description": "切换前是否先执行 logout。开启有时会让 IDE 重载窗口；默认关闭，直接覆盖会话。"
        },
        "windsurfPool.update.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动检查更新"
        },
        "windsurfPool.update.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "发现新版本时自动静默安装（无需用户确认）"
        },
        "windsurfPool.enhancement.enabled": {
          "type": "boolean",
          "default": false,
          "description": "启用 IDE 增强（汉化+回复建议提示+自动恢复），需手动激活"
        },
        "windsurfPool.enhancement.acpUnlock": {
          "type": "boolean",
          "default": true,
          "description": "解锁 ACP 自定义智能体（仅 Devin Desktop，绕过 acp-custom-enabled 限制）"
        },
        "windsurfPool.enhancement.autoRecovery": {
          "type": "boolean",
          "default": true,
          "description": "启用自动错误恢复（额度耗尽自动切号+自动重试）"
        },
        "windsurfPool.preflightSwitchCheck": {
          "type": "boolean",
          "default": true,
          "description": "切号预检：开启则切号前先调用官方 API 检查限速（多 0.5-2s 延迟，但能拦截当前模型限速的账号）。关闭则直接切，速度更快但可能切到限速的号。"
        },
        "windsurfPool.enhancement.fixChecksums": {
          "type": "boolean",
          "default": true,
          "description": "自动修复 product.json 中的 SHA256 校验值。增强/补丁会修改 workbench.html 等被校验的文件，导致每次启动弹\"installation appears corrupt\"提示；开启后会重算并写回正确哈希，从根本消除提示。"
        },
        "windsurfPool.devin.allowProcessProbing": {
          "type": "boolean",
          "default": false,
          "description": "Devin 专用：允许 Kite 在 Devin 扩展宿主内执行 wmic/PowerShell 进程探测（实例运行状态、ACP 重复进程清理）。默认关闭，因为 Devin 1.110+/Node 22 中启动或侧栏阶段执行这些子进程可能导致扩展宿主崩溃。"
        },
        "windsurfPool.devin.autoRecoverLegacyCredentials": {
          "type": "boolean",
          "default": false,
          "description": "Devin 专用：读取账号时自动尝试恢复历史凭据。默认关闭，因为该恢复依赖 Windows DPAPI/PowerShell，可能在 Devin 扩展宿主启动阶段触发崩溃；如需恢复请优先使用命令面板中的“修复缺失凭据”。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "package": "npm run build && vsce package --no-dependencies",
    "package:release": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "parse5": "^8.0.1"
  }
}
