{
  "name": "windsurf-pool",
  "displayName": "Windsurf 号池管理",
  "description": "Windsurf 无感换号：一键切换多账号，多实例分身，自动注入会话，实时显示每日/每周配额，免退出、免重启。",
  "version": "7.5.26",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/windsurf-pool"
  },
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "windsurfPool",
          "title": "Windsurf 号池管理",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "windsurfPool": [
        {
          "type": "webview",
          "id": "windsurfPool.sidebar",
          "name": " ",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "windsurfPool.openSidebar",
        "title": "打开换号侧栏",
        "category": "Windsurf Pool",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "windsurfPool.applyPatch",
        "title": "应用 Windsurf 注入补丁",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.showLog",
        "title": "显示日志面板",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.openLogFile",
        "title": "打开日志文件",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.addAccount",
        "title": "添加账号",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.switchAccount",
        "title": "切换账号（弹窗列表）",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.switchNextAccount",
        "title": "切换下一个账号",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.removeAccount",
        "title": "删除账号",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.showStatus",
        "title": "账号状态",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.checkForUpdates",
        "title": "检查更新",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.restoreWorkbench",
        "title": "恢复原始 Workbench",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.reinjectEnhancement",
        "title": "重新注入 Windsurf 增强",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.injectBubbleRules",
        "title": "注入智能建议规则",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.removeBubbleRules",
        "title": "移除智能建议规则",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.injectScriptDisciplineRules",
        "title": "注入脚本纪律规则",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.removeScriptDisciplineRules",
        "title": "移除脚本纪律规则",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.fixChecksums",
        "title": "修复 product.json 校验值（消除\"已损坏\"提示）",
        "category": "Windsurf Pool"
      },
      {
        "command": "windsurfPool.openLogPanel",
        "title": "打开统计面板",
        "category": "Windsurf Pool",
        "icon": "$(graph)"
      },
      {
        "command": "windsurfPool.openHealthCheck",
        "title": "打开测活面板",
        "category": "Windsurf Pool",
        "icon": "$(pulse)"
      },
      {
        "command": "windsurfPool.recoverCascadeInput",
        "title": "恢复 Cascade 输入",
        "category": "Windsurf Pool",
        "icon": "$(debug-restart)"
      }
    ],
    "keybindings": [
      {
        "command": "windsurfPool.switchNextAccount",
        "key": "ctrl+alt+shift+k",
        "mac": "cmd+alt+shift+k",
        "when": "true"
      },
      {
        "command": "windsurfPool.openLogPanel",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "Windsurf 号池管理",
      "properties": {
        "windsurfPool.refreshOnSwitch": {
          "type": "boolean",
          "default": false,
          "description": "切换账号后是否自动重载整个窗口。关闭则只注入会话（多数情况可不重载）；若界面未刷新再手动重载或改回开启。"
        },
        "windsurfPool.showSwitchNotification": {
          "type": "boolean",
          "default": false,
          "description": "切换时是否弹出「已切换」提示（侧栏下拉切换默认不弹）"
        },
        "windsurfPool.logoutBeforeSwitch": {
          "type": "boolean",
          "default": false,
          "description": "切换前是否先执行 windsurf.logout。开启有时会让 Windsurf 重载窗口；默认关闭，直接覆盖会话。"
        },
        "windsurfPool.update.repoOwner": {
          "type": "string",
          "default": "soulvon",
          "description": "GitHub 仓库所有者（用于自动更新）"
        },
        "windsurfPool.update.repoName": {
          "type": "string",
          "default": "windsurf-pool-releases",
          "description": "GitHub 仓库名（用于自动更新）"
        },
        "windsurfPool.update.token": {
          "type": "string",
          "default": "",
          "description": "GitHub Personal Access Token（用于访问私有仓库，需要 repo 权限）"
        },
        "windsurfPool.update.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动检查更新"
        },
        "windsurfPool.update.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "发现新版本时自动静默安装（无需用户确认）"
        },
        "windsurfPool.enhancement.enabled": {
          "type": "boolean",
          "default": false,
          "description": "启用 Windsurf 增强（汉化+回复建议提示+自动恢复），需手动激活"
        },
        "windsurfPool.enhancement.autoRecovery": {
          "type": "boolean",
          "default": true,
          "description": "启用自动错误恢复（额度耗尽自动切号+自动重试）"
        },
        "windsurfPool.preflightSwitchCheck": {
          "type": "boolean",
          "default": true,
          "description": "切号预检：开启则切号前先调用 Windsurf 官方 API 检查限速（多 0.5-2s 延迟，但能拦截当前模型限速的账号）。关闭则直接切，速度更快但可能切到限速的号。"
        },
        "windsurfPool.enhancement.fixChecksums": {
          "type": "boolean",
          "default": true,
          "description": "自动修复 product.json 中的 SHA256 校验值。增强/补丁会修改 workbench.html 等被校验的文件，导致每次启动弹\"installation appears corrupt\"提示；开启后会重算并写回正确哈希，从根本消除提示。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "package": "npm run build && vsce package --no-dependencies",
    "package:release": "npm run build && vsce package --no-dependencies && node scripts/upload-release.js",
    "upload": "node scripts/upload-release.js"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.22.0"
  }
}
