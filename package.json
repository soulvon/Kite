{
  "name": "windsurf-pool",
  "displayName": "IDE 增强助手",
  "description": "IDE 增强助手是面向 Windsurf / Devin 的 AI IDE 增强套件：界面增强、多实例分身、BYOK（开发中）自带 Key、多账号号池、自动恢复与长任务自动化。",
  "version": "8.6.9",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/windsurf-pool"
  },
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "windsurfPool",
          "title": "IDE 增强助手",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "windsurfPool": [
        {
          "type": "webview",
          "id": "windsurfPool.sidebar",
          "name": " ",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "windsurfPool.openSidebar",
        "title": "打开换号侧栏",
        "category": "IDE 增强助手",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "windsurfPool.applyPatch",
        "title": "应用 IDE 注入补丁",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.showLog",
        "title": "显示日志面板",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.openLogFile",
        "title": "打开日志文件",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.addAccount",
        "title": "添加账号",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.switchAccount",
        "title": "切换账号（弹窗列表）",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.switchNextAccount",
        "title": "切换下一个账号",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.removeAccount",
        "title": "删除账号",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.showStatus",
        "title": "账号状态",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.checkForUpdates",
        "title": "检查更新",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.restoreWorkbench",
        "title": "恢复原始 Workbench",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.reinjectEnhancement",
        "title": "重新注入 IDE 增强",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.injectBubbleRules",
        "title": "注入智能建议规则",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.removeBubbleRules",
        "title": "移除智能建议规则",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.injectScriptDisciplineRules",
        "title": "注入脚本纪律规则",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.removeScriptDisciplineRules",
        "title": "移除脚本纪律规则",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.fixChecksums",
        "title": "修复 product.json 校验值（消除\"已损坏\"提示）",
        "category": "IDE 增强助手"
      },
      {
        "command": "windsurfPool.openLogPanel",
        "title": "打开统计面板",
        "category": "IDE 增强助手",
        "icon": "$(graph)"
      },
      {
        "command": "windsurfPool.openHealthCheck",
        "title": "打开测活面板",
        "category": "IDE 增强助手",
        "icon": "$(pulse)"
      },
      {
        "command": "windsurfPool.recoverCascadeInput",
        "title": "恢复 Cascade 输入",
        "category": "IDE 增强助手",
        "icon": "$(debug-restart)"
      },
      {
        "command": "windsurfPool.byokStart",
        "title": "启动 BYOK Sidecar（开发中）",
        "category": "IDE 增强助手",
        "icon": "$(play)"
      },
      {
        "command": "windsurfPool.byokStop",
        "title": "停止 BYOK Sidecar",
        "category": "IDE 增强助手",
        "icon": "$(debug-stop)"
      },
      {
        "command": "windsurfPool.byokApplyPatch",
        "title": "应用 BYOK Patch（开发中）",
        "category": "IDE 增强助手",
        "icon": "$(plug)"
      },
      {
        "command": "windsurfPool.byokRestorePatch",
        "title": "恢复 BYOK Patch",
        "category": "IDE 增强助手",
        "icon": "$(debug-reverse-continue)"
      }
    ],
    "keybindings": [
      {
        "command": "windsurfPool.switchNextAccount",
        "key": "ctrl+alt+shift+k",
        "mac": "cmd+alt+shift+k",
        "when": "true"
      },
      {
        "command": "windsurfPool.openLogPanel",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "IDE 增强助手设置",
      "properties": {
        "windsurfPool.refreshOnSwitch": {
          "type": "boolean",
          "default": false,
          "description": "切换账号后是否自动重载整个窗口。关闭则只注入会话（多数情况可不重载）；若界面未刷新再手动重载或改回开启。"
        },
        "windsurfPool.showSwitchNotification": {
          "type": "boolean",
          "default": false,
          "description": "切换时是否弹出「已切换」提示（侧栏下拉切换默认不弹）"
        },
        "windsurfPool.logoutBeforeSwitch": {
          "type": "boolean",
          "default": false,
          "description": "切换前是否先执行 logout。开启有时会让 IDE 重载窗口；默认关闭，直接覆盖会话。"
        },
        "windsurfPool.update.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动检查更新"
        },
        "windsurfPool.update.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "发现新版本时自动静默安装（无需用户确认）"
        },
        "windsurfPool.enhancement.enabled": {
          "type": "boolean",
          "default": false,
          "description": "启用 IDE 增强（汉化+回复建议提示+自动恢复），需手动激活"
        },
        "windsurfPool.enhancement.acpUnlock": {
          "type": "boolean",
          "default": true,
          "description": "解锁 ACP 自定义智能体（仅 Devin Desktop，绕过 acp-custom-enabled 限制）"
        },
        "windsurfPool.enhancement.autoRecovery": {
          "type": "boolean",
          "default": true,
          "description": "启用自动错误恢复（额度耗尽自动切号+自动重试）"
        },
        "windsurfPool.preflightSwitchCheck": {
          "type": "boolean",
          "default": true,
          "description": "切号预检：开启则切号前先调用官方 API 检查限速（多 0.5-2s 延迟，但能拦截当前模型限速的账号）。关闭则直接切，速度更快但可能切到限速的号。"
        },
        "windsurfPool.enhancement.fixChecksums": {
          "type": "boolean",
          "default": true,
          "description": "自动修复 product.json 中的 SHA256 校验值。增强/补丁会修改 workbench.html 等被校验的文件，导致每次启动弹\"installation appears corrupt\"提示；开启后会重算并写回正确哈希，从根本消除提示。"
        },
        "windsurfPool.byok.nodePath": {
          "type": "string",
          "default": "node",
          "description": "BYOK sidecar 使用的 Node.js 可执行文件路径。"
        },
        "windsurfPool.byok.apiPort": {
          "type": "number",
          "default": 7450,
          "minimum": 1,
          "maximum": 65535,
          "description": "BYOK API 代理端口。"
        },
        "windsurfPool.byok.inferencePort": {
          "type": "number",
          "default": 7451,
          "minimum": 1,
          "maximum": 65535,
          "description": "BYOK inference 代理端口。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "package": "npm run build && vsce package --no-dependencies",
    "package:release": "npm run build && vsce package --no-dependencies && node scripts/upload-release.js",
    "upload": "node scripts/upload-release.js"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.22.0"
  }
}
