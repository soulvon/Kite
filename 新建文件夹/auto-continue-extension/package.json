{
  "name": "auto-continue-for-windsurf",
  "displayName": "Auto Continue for Windsurf",
  "description": "Windsurf/Cascade 自动续聊工具 — 检测AI异常终止后自动发送 Continue",
  "version": "1.0.1",
  "publisher": "auto-continue",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "auto-continue.toggle",
        "title": "Auto Continue: 开启/关闭自动续聊"
      },
      {
        "command": "auto-continue.configure",
        "title": "Auto Continue: 配置参数"
      },
      {
        "command": "auto-continue.resetLimit",
        "title": "Auto Continue: 重置频次计数"
      }
    ],
    "configuration": {
      "title": "Auto Continue",
      "properties": {
        "autoContinue.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否开启自动续聊"
        },
        "autoContinue.text": {
          "type": "string",
          "default": "Continue",
          "description": "异常终止时自动发送的文本"
        },
        "autoContinue.windowMs": {
          "type": "number",
          "default": 600000,
          "description": "频次统计时间窗口（毫秒），默认 600000 = 10 分钟"
        },
        "autoContinue.limitCount": {
          "type": "number",
          "default": 3,
          "description": "窗口内最多发送次数，超出后暂停直到窗口滑出"
        },
        "autoContinue.cooldownMs": {
          "type": "number",
          "default": 3000,
          "description": "两次发送之间的最小冷却时间（毫秒）"
        }
      }
    }
  }
}
